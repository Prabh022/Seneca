<!DOCTYPE html>
<html>
  <head>
    <title>View Data</title>
  </head>

  <body>
    <!-- Include header first -->
    <%- include('partials/header', { page: "View Data" }) %>

    <h2>User Data</h2>
    <table border="1">
      <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Occupation</th>
        <th>Company</th>
      </tr>
      <tr>
        <td><%= data.name %></td>
        <td><%= data.age %></td>
        <td><%= data.occupation %></td>
        <td><%= data.company %></td>
      </tr>
    </table>
  </body>
</html>
